# MarkovPortfolio V4 환경변수 예시
#
# 사용 방법:
# 1. 이 파일을 복사하여 .env 파일을 생성합니다: copy .env.example .env
# 2. .env 파일에서 실제 값으로 교체합니다.
# 3. .env 파일은 절대 git에 커밋하지 마세요 (API 키 노출 위험).
#
# .gitignore에 .env가 포함되어 있는지 반드시 확인하세요.

# ── Anthropic API 키 ─────────────────────────────────────────────────────
# Anthropic Console에서 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── 서버 설정 ────────────────────────────────────────────────────────────
# 로컬 개발: 127.0.0.1 (외부 노출 없음)
# 외부 접근이 필요한 경우: 0.0.0.0
HOST=127.0.0.1
PORT=8000

# ── 선택적 설정 (기본값으로 동작) ─────────────────────────────────────────
# CACHE_TTL=60                    # yfinance 캐시 TTL (초)
# CLAUDE_MODEL=claude-sonnet-4-6  # 사용할 Claude 모델
